{
  "manifest_version": 3,
  "name": "Memepot",
  "version": "0.1.0",
  "description": "A fast local meme library and meme clipboard for Chrome.",
  "permissions": [
    "contextMenus",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "action": {
    "default_title": "Memepot",
    "default_popup": "popup/index.html"
  },
  "options_page": "options/index.html",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"]
    }
  ]
}